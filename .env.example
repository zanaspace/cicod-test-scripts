# ==========================================
# Environment Variables Template
# Copy this file to .env and fill in your values
# DO NOT COMMIT THE REAL .env FILE
# ==========================================

# 1Government / GovTest Environment
TARGET_SITE_MDA="govtest"
TARGET_SITE_EMAIL="your-email@example.com"
TARGET_SITE_PASSWORD="your-password"
TARGET_SITE_URL="convergenceondemand.com"

# CICOD Commercial Enterprise Environment
target2_domain="your-tenant-subdomain"
target2_email="user@cicod.com"
target2_password="your-password"
target2_url="https://cicod.com/login?tenant=your-tenant-subdomain"

# CICOD SaaS Staging Environment
target3_domain="your-staging-subdomain"
target3_email="user@example.com"
target3_password="your-password"
target3_url="https://cicodsaasstaging.com/login?tenant=your-staging-subdomain"
