# ==========================================
# CICOD & 1Government Project .gitignore
# ==========================================

# 1. Environment & Sensitive Credentials (CRITICAL)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.pfx

# Allow .env.example template
!.env.example

# 2. Temporary Research & Scratch Directories
scratch/
scratch_*
*.tmp
*.bak
*.swp
*.swo

# 3. Logs & Diagnostic Traces
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# 4. Dependency & Package Managers
node_modules/
jspm_packages/
.pnpm-store/
.npm/
.yarn/
vendor/

# 5. Build Artifacts & Caches
dist/
build/
out/
.next/
.turbo/
.cache/

# 6. Python Environments & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
.pytest_cache/

# 7. Operating System Metadata
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# 8. Editor & IDE Settings
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.user
*.sublime-workspace
*.sublime-project
